# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git!

# ============================================
# AWS Cognito (Authentication)
# ============================================
VITE_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=<your-client-id>
VITE_COGNITO_DOMAIN=<your-app-name>.auth.eu-west-1.amazoncognito.com
VITE_AWS_REGION=eu-west-1

# ============================================
# Test Cognito Pool (S2 / T2) — used by local/E2E test runs only
# ============================================
# The standing test pool "myAdmin-test" (eu-west-1_xyrlzfqbl). Public, non-secret
# identifiers. Do NOT point the app's VITE_COGNITO_* above at the test pool; these
# TEST_ vars are for the test suite authenticating against the validation pool.
VITE_TEST_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
VITE_TEST_COGNITO_CLIENT_ID=<your-test-app-client-id>

# ============================================
# API Configuration
# ============================================
VITE_API_URL=http://localhost:5000
# For production: https://your-app.railway.app

# ============================================
# Members module API (S5b) — separate SAM app
# ============================================
# The Members module is a standalone SAM app (sam/members), NOT the main Flask
# backend. `membersApiService.ts` reads this via import.meta.env and fails fast
# if unset. Locally, `sam local start-api` serves it on http://127.0.0.1:3000.
# For production: the Members API base URL from the deployed SAM stack output.
VITE_MEMBERS_API_BASE_URL=http://127.0.0.1:3000

# ============================================
# OAuth Redirect URLs
# ============================================
VITE_REDIRECT_SIGN_IN=http://localhost:3000/
VITE_REDIRECT_SIGN_OUT=http://localhost:3000/
# For production, add your Railway URL

# ============================================
# Documentation
# ============================================
VITE_DOCS_URL=/docs
# For production: https://your-app.railway.app/docs
