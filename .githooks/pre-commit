#!/bin/sh
# ---------------------------------------------------------------------------
# myAdmin pre-commit guard: database-access abstraction (Req 1.5, 1.6, 1.7).
#
# Runs the two static AST guards against the STAGED backend Python files, each
# scoped to match the authoritative CI guard it mirrors:
#   1. check_db_imports.py      — bans direct mysql.connector imports.
#        Scope: all staged backend/**/*.py (its ALLOWED_FILES intentionally covers
#        a few backend/tests files, so tests ARE in scope for this guard).
#   2. check_raw_connection.py  — bans the raw get_connection()/_get_connection()
#        escape pattern. Scope: staged backend/src/**/*.py ONLY — the guard's
#        SCAN_DIRS is ['backend/src'] by design; backend/tests legitimately calls
#        the private _get_connection() to test it and is out of scope. Passing test
#        paths in single-file mode would bypass that scoping and false-positive, so
#        the hook filters to backend/src/ to stay consistent with the nightly CI gate.
#
# Any violation exits non-zero and blocks the commit. Pure AST static analysis:
# no DB connection, so it is fast and works offline. Bypassable with
# `git commit --no-verify` by design (the authoritative gate is the nightly
# Full Test Suite; this hook is fast local feedback only — Req 1.6).
#
# Mirrors the conventions of the sibling .githooks/pre-push hook: /bin/sh,
# `git rev-parse --show-toplevel` for the repo root, prefer the backend venv
# interpreter and fall back to PATH.
# ---------------------------------------------------------------------------

REPO_ROOT=$(git rev-parse --show-toplevel)

# Collect staged, added/copied/modified backend Python files (repo-root-relative
# POSIX paths — the form the guards' allow-lists are keyed on). Deletions
# (--diff-filter excludes D) and non-backend / non-.py files are skipped.
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/**/*.py')

if [ -z "$staged_py" ]; then
    # Nothing in backend/ to check — let the commit through immediately.
    exit 0
fi

# Partition the staged paths that still exist on disk into:
#   import_files — all staged backend python (check_db_imports scope)
#   raw_files    — only backend/src/** (check_raw_connection scope == its SCAN_DIRS)
import_files=""
raw_files=""
for f in $staged_py; do
    [ -f "$REPO_ROOT/$f" ] || continue
    import_files="$import_files $f"
    case "$f" in
        backend/src/*) raw_files="$raw_files $f" ;;
    esac
done
import_files=$(echo "$import_files" | xargs)
raw_files=$(echo "$raw_files" | xargs)

if [ -z "$import_files" ]; then
    exit 0
fi

# Prefer the backend venv interpreter (matches the pre-commit ruff convention),
# else fall back to python3 / python on PATH. The guards are stdlib-only (ast),
# so any Python 3 works.
PY=""
if [ -x "$REPO_ROOT/backend/.venv/bin/python" ]; then
    PY="$REPO_ROOT/backend/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
fi

if [ -z "$PY" ]; then
    echo "pre-commit: ERROR no Python interpreter found." >&2
    echo "  Install Python 3, or create the backend venv at backend/.venv." >&2
    exit 1
fi

# Run both guards from the repo root so the path args match the repo-root-relative
# keys in each guard's ALLOWED_FILES / PENDING_SITES allow-list. Run both even if
# the first fails, so the committer sees every violation at once.
status=0

echo "pre-commit: checking staged backend file(s) for DB-access violations..."

# Import guard: all staged backend python (tests included — matches its ALLOWED_FILES scope).
if ! (cd "$REPO_ROOT" && "$PY" backend/scripts/check_db_imports.py $import_files); then
    status=1
fi

# Raw-connection guard: ONLY staged backend/src python (matches its SCAN_DIRS=['backend/src']).
if [ -n "$raw_files" ]; then
    if ! (cd "$REPO_ROOT" && "$PY" backend/scripts/check_raw_connection.py $raw_files); then
        status=1
    fi
fi

if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: database-access guard failed — commit blocked." >&2
    echo "  Fix the violations above, or bypass with 'git commit --no-verify'." >&2
    exit 1
fi

echo "pre-commit: DB-access guards passed."

# ---------------------------------------------------------------------------
# SAM config#fields CRUD guard (spec 03 "config-fields-foolproof-crud" R11.2;
# steering 39 → Enforcement). The SAM / DynamoDB counterpart to the DB-access
# guards above: scripts/check_sam_config_crud.py fails on (a) a raw governance-
# table put_item/update_item/delete_item OUTSIDE the sanctioned Change-Op write
# repository (+ the C6 migration), and (b) a raw storage-shape key (field_overlay
# /overrides/fixed_overrides/dotted {group}.{key}) in an API response. This keeps
# the whole-record replace an internal primitive and the raw shape off the wire —
# the proven partial-overlay-overwrites-full-record defect cannot be reintroduced.
#
# Scope: STAGED sam/**/*.py (the guard's own single-file CLI mode), mirroring the
# staged-file scoping of the DB-access guards. The baseline tree is clean, so this
# is wired BLOCKING from the start (report-only → clear baseline → blocking,
# steering 39; the baseline was verified clean before flipping). A new sanctioned
# write site is a reviewed allow-list addition in the guard, NEVER a --no-verify.
# Pure AST static analysis (stdlib only): fast, offline. Bypassable with
# `git commit --no-verify` by design (the nightly Full Test Suite is the
# authoritative gate — this hook is fast local feedback only).
# ---------------------------------------------------------------------------
staged_sam_py=$(git diff --cached --name-only --diff-filter=ACM -- 'sam/**/*.py')
sam_crud_files=""
for f in $staged_sam_py; do
    [ -f "$REPO_ROOT/$f" ] || continue
    sam_crud_files="$sam_crud_files $f"
done
sam_crud_files=$(echo "$sam_crud_files" | xargs)

if [ -n "$sam_crud_files" ]; then
    echo "pre-commit: checking staged sam/ file(s) for config#fields CRUD violations..."
    if ! (cd "$REPO_ROOT" && "$PY" scripts/check_sam_config_crud.py $sam_crud_files); then
        echo "" >&2
        echo "pre-commit: SAM config#fields CRUD guard failed — commit blocked." >&2
        echo "  Fix the violations above (route the write through the Change-Op repository /" >&2
        echo "  serve the resolved Flat_View), or bypass with 'git commit --no-verify'." >&2
        exit 1
    fi
    echo "pre-commit: SAM config#fields CRUD guard passed."
fi

# ---------------------------------------------------------------------------
# ruff-format guard (Req: prevent recurrence of the 2026-10-17 H3 CI-blocking
# format drift). The authoritative backend CI gate runs
#   ruff format --check src/ --exclude src/validate_pattern/
# from backend/ and BLOCKS the Full Test Suite on drift (full-test-suite.yml).
# A format-only drift should be caught here locally, not at the CI gate.
#
# Scope: STAGED backend/** + sam/** Python files only — mirroring the staged-
# file scoping of the DB-access guards above. A whole-tree `ruff format --check
# backend/ sam/` is deliberately NOT used: the existing tree is not uniformly
# ruff-formatted (notably sam/, whose CI check is non-blocking `|| true`), so a
# whole-tree check would reject nearly every commit. Checking only the files a
# commit introduces catches drift like the two PR #121 files without drowning in
# pre-existing debt, and stays fast (pure formatter check, no network).
#
# Honours each tree's CI config: src/validate_pattern/ is excluded (matches the
# backend CI --exclude); sam/ files are checked with sam's resolved config.
# Bypassable with `git commit --no-verify` by design (fast local feedback only).
# ---------------------------------------------------------------------------

# Resolve a ruff binary: prefer the backend venv (matches $PY above), else PATH.
RUFF=""
if [ -x "$REPO_ROOT/backend/.venv/bin/ruff" ]; then
    RUFF="$REPO_ROOT/backend/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
fi

if [ -n "$RUFF" ]; then
    # Partition the staged python into backend/** and sam/** (each uses the
    # exclude/config its CI gate uses). backend/src/validate_pattern/ is dropped
    # to match the backend CI --exclude.
    backend_fmt=""
    sam_fmt=""
    for f in $staged_py; do
        [ -f "$REPO_ROOT/$f" ] || continue
        case "$f" in
            backend/src/validate_pattern/*) : ;;  # excluded by backend CI
            backend/*) backend_fmt="$backend_fmt $f" ;;
        esac
    done
    # sam/** python is not in $staged_py (that globs backend/**); collect it too.
    staged_sam_py=$(git diff --cached --name-only --diff-filter=ACM -- 'sam/**/*.py')
    for f in $staged_sam_py; do
        [ -f "$REPO_ROOT/$f" ] || continue
        sam_fmt="$sam_fmt $f"
    done
    backend_fmt=$(echo "$backend_fmt" | xargs)
    sam_fmt=$(echo "$sam_fmt" | xargs)

    fmt_status=0
    if [ -n "$backend_fmt" ]; then
        if ! (cd "$REPO_ROOT" && "$RUFF" format --check $backend_fmt); then
            fmt_status=1
        fi
    fi
    if [ -n "$sam_fmt" ]; then
        # $sam_fmt holds REPO-ROOT-relative paths (e.g. sam/tests/foo.py), so run
        # the check from $REPO_ROOT — not $REPO_ROOT/sam, which doubled the prefix
        # to sam/sam/... and made ruff fail with os-error-2 on a valid, formatted
        # file. The sam ruff.toml is still applied via --config.
        if ! (cd "$REPO_ROOT" && "$RUFF" format --check --config "$REPO_ROOT/backend/ruff.toml" $sam_fmt); then
            fmt_status=1
        fi
    fi

    if [ "$fmt_status" -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: ruff-format drift in staged file(s) — commit blocked." >&2
        echo "  Fix with:  ruff format $backend_fmt $sam_fmt" >&2
        echo "  Then 're-stage' and commit again, or bypass with 'git commit --no-verify'." >&2
        exit 1
    fi
    echo "pre-commit: ruff-format check passed."
else
    echo "pre-commit: ruff not found — skipping format check (install ruff in backend/.venv)." >&2
fi

exit 0
