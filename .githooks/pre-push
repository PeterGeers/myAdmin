#!/bin/sh
# Pre-push hook: scans only CHANGED files being pushed for secrets.
# Uses ggshield if available, falls back to local regex scanner.
# Blocks push if secrets are found.

echo "Running secret scan before push..."

REPO_ROOT=$(git rev-parse --show-toplevel)

# Determine the commit range being pushed
# Read stdin for the push info (local_ref local_sha remote_ref remote_sha)
while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip delete pushes
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # If remote_sha is all zeros, this is a new branch — scan all files in the push
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch: scan all files in the pushed commits vs main
        remote_sha=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
        if [ -z "$remote_sha" ]; then
            # No common ancestor — scan all files
            remote_sha=$(git hash-object -t tree /dev/null)
        fi
    fi

    # Get list of files changed in the commits being pushed
    changed_files=$(git diff --name-only --diff-filter=ACM "$remote_sha" "$local_sha" 2>/dev/null)

    if [ -z "$changed_files" ]; then
        echo "No changed files to scan."
        exit 0
    fi

    echo "Scanning $(echo "$changed_files" | wc -l | tr -d ' ') files being pushed..."

    # Filter out paths that ggshield would reject as "ignored".
    # ggshield exits with error code 2 if ANY path matches its ignored_paths
    # in .gitguardian.yaml (e.g. **/tests/**, **/.venv/**, etc.).
    # We must exclude those paths before calling ggshield.
    filtered_files=""
    for f in $changed_files; do
        # Skip files that don't exist on disk (deleted in working tree)
        if [ ! -f "$REPO_ROOT/$f" ]; then
            continue
        fi
        # Skip paths matching .gitguardian.yaml ignored_paths patterns
        case "$f" in
            */.venv/*|*/venv/*|*/node_modules/*|*/.git/*) continue ;;
            */build/*|*/dist/*|*/__pycache__/*|*.pyc) continue ;;
            */mysql_data/*|*/logs/*|*/.pytest_cache/*) continue ;;
            */.hypothesis/*|*/tests/*|*/coverage/*) continue ;;
            *.log|*/terraform.tfstate*|*/.terraform/*) continue ;;
            *.example|*-example.*) continue ;;
        esac
        filtered_files="$filtered_files $f"
    done
    filtered_files=$(echo "$filtered_files" | xargs)

    if [ -z "$filtered_files" ]; then
        echo "No scannable files to check."
        exit 0
    fi

    # Try ggshield first (scan only changed files — quota-friendly)
    if command -v ggshield >/dev/null 2>&1; then
        output=$(cd "$REPO_ROOT" && ggshield secret scan path --yes $filtered_files 2>&1)
        code=$?

        # Detect quota exhaustion or ignored-file errors
        if echo "$output" | grep -qiE "no more API calls|quota|rate.limit"; then
            echo "ggshield quota exhausted - falling back to local scanner"
            "$REPO_ROOT/scripts/scan-secrets-local.sh" --pre-push "$remote_sha" "$local_sha"
            exit $?
        fi

        # If ggshield fails due to ignored/unreadable files, fall back to local scanner
        if [ $code -ne 0 ] && echo "$output" | grep -qiE "ignored file|cannot be scanned"; then
            echo "ggshield cannot scan some files - falling back to local scanner"
            "$REPO_ROOT/scripts/scan-secrets-local.sh" --pre-push "$remote_sha" "$local_sha"
            exit $?
        fi

        echo "$output"
        exit $code
    else
        echo "ggshield not found - running local scanner"
        "$REPO_ROOT/scripts/scan-secrets-local.sh" --pre-push "$remote_sha" "$local_sha"
        exit $?
    fi
done

exit 0
