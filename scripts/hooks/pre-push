#!/bin/sh
# ---------------------------------------------------------------------------
# myAdmin pre-push guard (committed, version-controlled).
#
# Install with: sh scripts/hooks/install-hooks.sh
#
# ORIGINAL BEHAVIOUR (spec full-test-suite-fixes-2026-10-02, task M1):
#   Clean-checkout import/collect smoke test. Catches the failure class that
#   reddened CI on 2026-10-02: a source module present in the working tree but
#   NOT tracked by git (e.g. swallowed by an over-broad .gitignore pattern). A
#   formatter/linter gate cannot see that — the file is on disk locally — so
#   only a `pytest --collect-only` against the *tracked* file set exposes it,
#   the same way CI's fresh checkout does.
#
# BROADENED BEHAVIOUR (spec full-test-suite-fixes-2026-10-03 → -10-04, task L1):
#   The 2026-10-03 regression (46 runtime test failures + 40 RUF059 + 1
#   ruff-format) and the 2026-10-04 regression (17 runtime failures + 39 ruff
#   lint incl. a 27×F401 `import os` sweep + 17 un-formatted files) were both
#   INVISIBLE to a collect-only guard — collection succeeded, the tests
#   ran-and-failed and lint reddened only in CI. So, within the SAME
#   clean-checkout stash window (so they see the tracked file set), after the
#   SAM collect succeeds we now also run:
#     - ruff check         on the WHOLE backend/src/ tree
#     - ruff format --check on the WHOLE backend/src/ tree
#     - a changed-path pytest subset (via the project's scoped_runner, mapped
#       from the files being pushed; basename-mapping fallback otherwise)
#   Each gate fails the push (exit 1) on error. Cheap checks (ruff) run before
#   the test subset.
#
#   NOTE on ruff scope (changed vs 2026-10-03): the 2026-10-03 guard scoped
#   ruff to the changed files only, to dodge pre-existing out-of-scope
#   `environment/**` lint + format debt on HEAD. Tasks H2/H3 of this spec
#   cleared that debt (`ruff check src/` + `ruff format --check src/` are both
#   clean on HEAD), so the guard now lints/formats the WHOLE `src/` tree — this
#   mirrors exactly what the CI "Backend Lint & Static Analysis" job runs and
#   would have caught this cycle's F401 sweep + format drift regardless of
#   which files a given push happened to touch.
#
# TOLERANCE: if no python / no ruff is available the relevant gate WARNs and is
#   skipped (matching the original "no python → skip" behaviour) rather than
#   hard-failing — the guard is a safety net, not a hard dependency.
#
# How the clean checkout works: temporarily stash untracked + ignored files (so
# the tree matches a clean checkout of tracked files only), run the gates, then
# ALWAYS restore the stash via an EXIT/INT/TERM trap.
#
# Opt out:
#   SKIP_PREPUSH=1          git push ...   # master switch — skip the WHOLE guard
#   SKIP_PREPUSH_COLLECT=1  git push ...   # legacy switch — same effect, kept for
#                                          # backwards compatibility
# ---------------------------------------------------------------------------
set -u

if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: SKIP_PREPUSH=1 set — skipping the entire pre-push guard." >&2
    exit 0
fi

if [ "${SKIP_PREPUSH_COLLECT:-0}" = "1" ]; then
    echo "pre-push: SKIP_PREPUSH_COLLECT=1 set — skipping the entire pre-push guard." >&2
    exit 0
fi

REPO_ROOT="$(pwd)"

# ---------------------------------------------------------------------------
# Capture the pushed commit range from stdin BEFORE we stash (stdin is only
# available to the hook, and the stash must not interfere with reading it).
# Git feeds one line per ref:  <local_ref> <local_sha> <remote_ref> <remote_sha>
# We union the changed-file sets across all pushed refs. New-branch pushes have
# an all-zero remote_sha; resolve a base via merge-base against origin/main,
# mirroring .githooks/pre-push's range logic.
#
# NOTE: when invoked manually with no stdin (e.g. `bash scripts/hooks/pre-push
# </dev/null`), there is no push range — the ruff gates still run against the
# whole src/ tree (they do not depend on the range); only the changed-path
# pytest subset is skipped with a note.
# ---------------------------------------------------------------------------
ZERO="0000000000000000000000000000000000000000"
CHANGED_FILES=""
RANGE_SEEN=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # Skip branch deletions (nothing to push).
    [ "$local_sha" = "$ZERO" ] && continue

    base="$remote_sha"
    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: diff the pushed commits against their merge-base with main.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")"
        if [ -z "$base" ]; then
            # No common ancestor — use the empty tree so everything shows as added.
            base="$(git hash-object -t tree /dev/null)"
        fi
    fi

    files="$(git diff --name-only --diff-filter=ACM "$base" "$local_sha" 2>/dev/null)"
    if [ -n "$files" ]; then
        CHANGED_FILES="$CHANGED_FILES
$files"
    fi
    RANGE_SEEN=1
done

# De-duplicate the accumulated changed-file list.
if [ -n "$CHANGED_FILES" ]; then
    CHANGED_FILES="$(printf '%s\n' "$CHANGED_FILES" | sed '/^$/d' | sort -u)"
fi

# Changed backend python files (relative to REPO_ROOT), used by the pytest
# subset gate to decide which tests to run.
CHANGED_BACKEND_PY="$(printf '%s\n' "$CHANGED_FILES" | grep -E '^backend/.*\.py$' || true)"

# ---------------------------------------------------------------------------
# Resolve a python interpreter: prefer the backend venv, else PATH python3/python.
# ---------------------------------------------------------------------------
PY=""
if [ -x "$REPO_ROOT/backend/.venv/bin/python" ]; then
    PY="$REPO_ROOT/backend/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
fi

if [ -z "$PY" ]; then
    echo "pre-push: WARNING no python interpreter found; skipping all gates." >&2
    exit 0
fi

# Resolve ruff: prefer the backend venv, else PATH. Empty if unavailable.
RUFF=""
if [ -x "$REPO_ROOT/backend/.venv/bin/ruff" ]; then
    RUFF="$REPO_ROOT/backend/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
fi

# ---------------------------------------------------------------------------
# Clean-checkout stash. Only stash if there is something to stash, so a clean
# tree pushes with no side effects. ALL gates below run inside this window.
# ---------------------------------------------------------------------------
STASHED=0
if ! git diff --quiet || ! git diff --cached --quiet || \
   [ -n "$(git ls-files --others --exclude-standard)" ] || \
   [ -n "$(git ls-files --others --ignored --exclude-standard)" ]; then
    echo "pre-push: stashing working-tree + untracked/ignored files to mimic a clean checkout ..."
    if git stash push --include-untracked --all --quiet --message "pre-push-clean-collect" ; then
        STASHED=1
    else
        echo "pre-push: WARNING could not stash; skipping gates to avoid touching your tree." >&2
        exit 0
    fi
fi

# Always restore the stash, whatever happens next.
restore() {
    if [ "$STASHED" = "1" ]; then
        echo "pre-push: restoring stashed changes ..."
        git stash pop --quiet || echo "pre-push: WARNING 'git stash pop' failed — recover with 'git stash list' / 'git stash pop'." >&2
    fi
}
trap restore EXIT INT TERM

# ---------------------------------------------------------------------------
# Gate 1 (original): SAM collect against the tracked file set.
# ---------------------------------------------------------------------------
echo "pre-push: [1/4] collecting SAM plane against the tracked file set ..."
PYTHONPATH="$REPO_ROOT" "$PY" -m pytest sam/tests --collect-only -q >/tmp/myadmin-prepush-collect.log 2>&1
RC=$?

if [ "$RC" -ne 0 ]; then
    echo "pre-push: ERROR SAM collection FAILED against the tracked file set (exit $RC)." >&2
    echo "pre-push: this usually means a required source file is present locally but NOT committed" >&2
    echo "pre-push: (e.g. ignored by .gitignore). CI will fail the same way. Details:" >&2
    tail -n 25 /tmp/myadmin-prepush-collect.log >&2
    exit 1
fi
echo "pre-push: SAM collect OK — no untracked-but-required modules detected."

# ---------------------------------------------------------------------------
# Gate 2: ruff lint on the WHOLE backend/src/ tree — mirrors the CI
# "Backend Lint & Static Analysis" job (`cd backend && ruff check src/`).
# Cheap, so it runs before the pytest subset.
# ---------------------------------------------------------------------------
echo "pre-push: [2/4] ruff check (backend/src/) ..."
if [ -z "$RUFF" ]; then
    echo "pre-push: WARNING ruff not found; skipping lint + format gates." >&2
else
    ( cd "$REPO_ROOT/backend" && "$RUFF" check src/ )
    RC=$?
    if [ "$RC" -ne 0 ]; then
        echo "pre-push: ERROR ruff check reported lint errors in backend/src/ (exit $RC)." >&2
        echo "pre-push: fix them (or 'cd backend && ruff check src/ --fix' where safe) before pushing. CI will fail the same way." >&2
        exit 1
    fi
    echo "pre-push: ruff check OK."

    # -----------------------------------------------------------------------
    # Gate 3: ruff format --check on the WHOLE backend/src/ tree — mirrors CI
    # (`cd backend && ruff format --check src/`).
    # -----------------------------------------------------------------------
    echo "pre-push: [3/4] ruff format --check (backend/src/) ..."
    ( cd "$REPO_ROOT/backend" && "$RUFF" format --check src/ )
    RC=$?
    if [ "$RC" -ne 0 ]; then
        echo "pre-push: ERROR ruff format --check found unformatted files in backend/src/ (exit $RC)." >&2
        echo "pre-push: run 'cd backend && ruff format src/' and re-stage before pushing. CI will fail the same way." >&2
        exit 1
    fi
    echo "pre-push: ruff format --check OK."
fi

# ---------------------------------------------------------------------------
# Gate 4: changed-path pytest subset. We map the files being pushed (the push
# range computed above, relative to REPO_ROOT) to their test files and run only
# those — fast and non-flaky, never the whole slow suite.
#
# Mechanism: PREFER the project's scoped_runner
# (`backend/scripts/test_maintenance/scoped_runner.py`, the testing-steering's
# preferred changed-path runner). We feed it the push-range changed files
# explicitly rather than its --git-diff mode, because inside the clean-checkout
# stash window `git diff HEAD` is empty — the push range is the correct source
# here. scoped_runner uses a dependency map when present; when that map is
# ABSENT (the current repo state) it falls back to same-directory tests only,
# which cannot map src/foo.py -> tests/unit/test_foo.py. So we ALSO run a
# robust basename→test mapping (src/foo.py -> tests/unit/test_foo*.py, and any
# changed test file directly). Both are fast; either one failing fails the
# push. This guarantees real coverage today and automatically improves once a
# dependency map lands.
# ---------------------------------------------------------------------------
echo "pre-push: [4/4] pytest subset for changed backend modules ..."
if [ -z "$CHANGED_BACKEND_PY" ]; then
    if [ "$RANGE_SEEN" = "1" ]; then
        echo "pre-push: no changed backend python files — nothing to test."
    else
        echo "pre-push: no push range on stdin — skipping changed-path pytest subset."
    fi
else
    # -- 4a: scoped_runner (preferred), if present --------------------------
    if [ -f "$REPO_ROOT/backend/scripts/test_maintenance/scoped_runner.py" ]; then
        echo "pre-push: scoped_runner for the pushed backend files:"
        printf '  %s\n' $CHANGED_BACKEND_PY >&2
        # project-root-relative paths; run from backend/ as a module (matches the
        # testing-steering invocation). Exit 0=pass, 1=failures, 2=runner error.
        ( cd "$REPO_ROOT/backend" && PYTHONPATH="$REPO_ROOT/backend/src" \
            "$PY" -m scripts.test_maintenance.scoped_runner $CHANGED_BACKEND_PY )
        RC=$?
        if [ "$RC" -ne 0 ]; then
            echo "pre-push: ERROR scoped_runner reported failures (exit $RC). CI will fail the same way." >&2
            exit 1
        fi
    fi

    # -- 4b: robust basename→test mapping (effective without a dep map) -----
    TEST_TARGETS=""
    for f in $CHANGED_BACKEND_PY; do
        # Changed test files run directly.
        case "$f" in
            backend/tests/*)
                if [ -f "$REPO_ROOT/$f" ]; then
                    TEST_TARGETS="$TEST_TARGETS $f"
                fi
                continue
                ;;
        esac
        base="$(basename "$f" .py)"
        for cand in "backend/tests/unit/test_${base}.py" "backend/tests/unit/test_${base}_"*.py; do
            if [ -f "$REPO_ROOT/$cand" ]; then
                TEST_TARGETS="$TEST_TARGETS $cand"
            fi
        done
    done

    if [ -n "$TEST_TARGETS" ]; then
        TEST_TARGETS="$(printf '%s\n' $TEST_TARGETS | sort -u | xargs)"
    fi

    if [ -z "$TEST_TARGETS" ]; then
        echo "pre-push: no basename-mapped unit tests for the changed backend modules."
    else
        echo "pre-push: running affected tests:"
        printf '  %s\n' $TEST_TARGETS >&2
        ( cd "$REPO_ROOT/backend" && PYTHONPATH="$REPO_ROOT/backend/src" "$PY" -m pytest $TEST_TARGETS -q -x )
        RC=$?
        if [ "$RC" -ne 0 ]; then
            echo "pre-push: ERROR affected unit tests FAILED (exit $RC). CI will fail the same way." >&2
            exit 1
        fi
        echo "pre-push: affected unit tests passed."
    fi
fi

echo "pre-push: all gates passed."
exit 0
