# myAdmin Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git!
#
# ============================================
# THE THREE .env FILES — intended separation
# ============================================
# This repo has three distinct .env files; each has one job. Keep them separate.
#
#   ROOT .env         (this file's target) — Railway wrapper + root-run scripts ONLY.
#                     Its real current purpose is the RAILWAY_DB_* production DB
#                     creds that backend/scripts/railway-db.sh reads (it does
#                     `source "$REPO_ROOT/.env"`). The backend app no longer reads
#                     this file: every loader under backend/src now pins
#                     backend/.env (Path(__file__).parent.parent/".env"), so the
#                     static AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
#                     AWS_ENDPOINT_URL_DYNAMODB that used to live here no longer
#                     clobber boto3's AWS_PROFILE at import time. RECOMMENDATION:
#                     keep those static personal-account AWS keys OUT of the app's
#                     load path — a root .env that only carries RAILWAY_DB_* (plus
#                     anything a root-run script genuinely needs) avoids resurrecting
#                     the clobber. Do not point DB_* here at the app's local DB.
#
#   backend/.env      — local Flask / Docker backend config + local secrets
#                     (DB_*, COGNITO_*, OPENROUTER_API_KEY, etc.). This is what the
#                     backend app and docker-compose load.
#
#   frontend/.env     — Vite SPA config only (VITE_* vars, incl. VITE_APP_ENV).

# ============================================
# AWS Cognito (Authentication)
# ============================================
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=<your-client-id>
COGNITO_CLIENT_SECRET=<your-client-secret>
AWS_REGION=eu-west-1

# ============================================
# Database Configuration
# ============================================
DB_HOST=mysql              # 'mysql' for Docker, 'localhost' for local
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_NAME=finance
DB_PORT=3306
MYSQL_ROOT_PASSWORD=<your-root-password>
MYSQL_PASSWORD=<your-db-password>

# ============================================
# Google Drive Integration
# ============================================
FACTUREN_FOLDER_ID=<your-google-drive-folder-id>
FACTUREN_FOLDER_NAME=Facturen

# ============================================
# OpenRouter AI
# ============================================
OPENROUTER_API_KEY=sk-or-v1-<your-api-key-here>

# ============================================
# AWS SNS (Notifications)
# ============================================
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:<account-id>:myadmin-notifications

# ============================================
# AWS S3 Storage
# ============================================
# Shared S3 bucket for tenant document storage (invoices, branding, templates)
S3_SHARED_BUCKET=<your-s3-bucket-name>

# ============================================
# Test Environment
# ============================================
TEST_MODE=false
TEST_DB_NAME=testfinance
TEST_FACTUREN_FOLDER_ID=<your-test-folder-id>
TEST_FACTUREN_FOLDER_NAME=testFacturen

# ============================================
# Credentials Encryption (Railway Migration)
# ============================================
# This key encrypts tenant-specific credentials stored in MySQL
# CRITICAL: Never commit this key to version control!
# Generate using: python scripts/generate_encryption_key.py
# NOTE: Use a DIFFERENT key for test environment than production
CREDENTIALS_ENCRYPTION_KEY=<your-64-character-hex-key>
