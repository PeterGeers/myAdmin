# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git!

# ============================================
# AWS Cognito (Authentication)
# ============================================
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=<your-client-id>
COGNITO_CLIENT_SECRET=<your-client-secret>
AWS_REGION=eu-west-1

# ============================================
# AWS IAM Credentials (Required for boto3)
# ============================================
# These are needed for backend to call AWS APIs (Cognito, SNS, etc.)
# Get these from ~/.aws/credentials or AWS IAM Console
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost          # 'mysql' for Docker, 'localhost' for local
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_NAME=finance
DB_PORT=3306

# ============================================
# Google Drive Integration
# ============================================
FACTUREN_FOLDER_ID=<your-google-drive-folder-id>
FACTUREN_FOLDER_NAME=Facturen

# ============================================
# OpenRouter AI
# ============================================
OPENROUTER_API_KEY=sk-or-v1-<your-api-key-here>

# ============================================
# AWS SNS (Notifications)
# ============================================
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:<account-id>:myadmin-notifications

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:3000

# SES Email Configuration (User-facing emails)
# ============================================
SES_SENDER_EMAIL=support@jabaki.nl

# ============================================
# Test Environment
# ============================================
TEST_MODE=false
TEST_DB_NAME=testfinance
TEST_FACTUREN_FOLDER_ID=<your-test-folder-id>
TEST_FACTUREN_FOLDER_NAME=testFacturen

# ============================================
# Test Cognito Pool — issuer->pool registry entry (S2 / T2)
# ============================================
# The standing test pool "myAdmin-test" (eu-west-1_xyrlzfqbl) is the identity
# validation environment for all S2/S3/S4 work — used alongside Docker MySQL and
# the test DynamoDB tables. These are PUBLIC, non-secret identifiers (the test
# app-client has no secret and uses USER_PASSWORD_AUTH), so they are safe to set
# here.
#
# FAIL-FAST: the loader (backend/src/auth/test_pool_config.py) throws if any of
# these are missing or blank. There is NO default — the test env can never
# silently fall back to a wrong or production pool (no-dangerous-fallbacks).
# Registry entry shape: iss -> { jwks_uri, audience/client_id, pool_label }.
TEST_COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX
TEST_COGNITO_JWKS_URI=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX/.well-known/jwks.json
TEST_COGNITO_CLIENT_ID=<your-test-app-client-id>
TEST_COGNITO_POOL_LABEL=myAdmin-test

# ---- Issuer->pool REGISTRY (S2 / T3) ----
# Adding a pool is CONFIGURATION, NOT CODE. COGNITO_POOL_KEYS is a comma-separated
# list of pool keys; each key {K} names four required vars:
#   {K}_COGNITO_ISSUER / {K}_COGNITO_JWKS_URI / {K}_COGNITO_CLIENT_ID / {K}_COGNITO_POOL_LABEL
# The loader (backend/src/auth/pool_registry.py) throws (fail-fast, no default) if
# COGNITO_POOL_KEYS is blank or any required var for a declared pool is missing/blank.
# The standing test pool uses key "TEST" and reuses the TEST_COGNITO_* vars above.
# Production Pool A (eu-west-1_Hdp40eWmu) is added later (Phase 6/T13) as a registry
# entry only — e.g. COGNITO_POOL_KEYS=TEST,PROD_A plus PROD_A_COGNITO_* vars.
COGNITO_POOL_KEYS=TEST

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=<generate-a-random-secret-key>

# ============================================
# Credentials Encryption (Railway Migration)
# ============================================
# This key encrypts tenant-specific credentials stored in MySQL
# CRITICAL: Never commit this key to version control!
# Generate using: python scripts/generate_encryption_key.py
CREDENTIALS_ENCRYPTION_KEY=<your-64-character-hex-key>

# ============================================
# Trial Signup API
# ============================================
# Separate promo database for signup data isolation
PROMO_DB_NAME=myadmin_promo

# Cognito app client for public signup (same pool, no client secret)
SIGNUP_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
SIGNUP_COGNITO_APP_CLIENT_ID=<your-signup-app-client-id>

# Admin notification email
SIGNUP_ADMIN_EMAIL=peter@jabaki.nl

# CSRF shared secret for signup form validation
CSRF_SECRET=<your-csrf-secret-here>

# Redirect URL after email verification
SIGNUP_REDIRECT_URL=https://app.myadmin.jabaki.nl/welcome

# ---- Production Pool A registry entry (S2 / T13a) — the existing myAdmin pool ----
# Pool A is the EXISTING production Cognito pool named `myAdmin`
# (eu-west-1_Hdp40eWmu, app client `myAdmin-client` = 66tp0087h9tfbstggonnu5aghp).
# No pool-side change was needed: Pool A already issues RS256/JWKS tokens with
# cognito:groups + custom:tenants exactly as the S2 verifier expects (confirmed by a
# read-only diff against the standing test pool — identical attrs/groups/LambdaConfig).
# These are PUBLIC, non-secret identifiers (the pool's JWKS + app-client id).
#
# In PRODUCTION, set:  COGNITO_POOL_KEYS=PROD_A   (verify real Pool A tokens)
#   or, to also accept test-pool tokens in a shared env:  COGNITO_POOL_KEYS=TEST,PROD_A
# Local dev/test keeps COGNITO_POOL_KEYS=TEST (above) so it validates against the
# test pool only; do NOT add PROD_A to the local key list unless these vars are set.
PROD_A_COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_Hdp40eWmu
PROD_A_COGNITO_JWKS_URI=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_Hdp40eWmu/.well-known/jwks.json
PROD_A_COGNITO_CLIENT_ID=66tp0087h9tfbstggonnu5aghp
PROD_A_COGNITO_POOL_LABEL=myAdmin
